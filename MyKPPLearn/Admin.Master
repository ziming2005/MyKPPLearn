<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="MyKPPLearn.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">MyKPP Learn</asp:ContentPlaceHolder></title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/Content/css/site.css" runat="server" />
    <link rel="stylesheet" href="~/Content/css/components.css?v=20261017-promo" runat="server" />
    <link rel="stylesheet" href="~/Content/css/forms.css?v=20261018-focus" runat="server" />
    <link rel="stylesheet" href="~/Content/css/app-shell.css?v=20261018-admindash" runat="server" />
    <link rel="stylesheet" href="~/Content/css/admin.css?v=20261019-db2" runat="server" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-shell">
            <div id="appDrawerBackdrop" class="app-drawer-backdrop"></div>

            <aside id="appSidebar" class="app-sidebar app-sidebar--admin">
                <div class="app-sidebar__brand">
                    <a class="site-logo" href="~/Admin/Dashboard.aspx" runat="server">My<span>KPP</span> Learn</a>
                </div>

                <nav class="app-sidebar__nav" aria-label="Administrator">
                    <ul class="app-nav-list">
                        <li><a id="navDashboard" runat="server" class="app-nav-link" href="~/Admin/Dashboard.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>Dashboard</a></li>
                        <li><a id="navLearnerRecords" runat="server" class="app-nav-link" href="~/Admin/LearnerRecords.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Learner Records</a></li>
                        <li class="app-nav-group">
                            <span class="app-nav-group__label">Learning</span>
                            <ul class="app-nav-group__list">
                                <li><a id="navChapters" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/LearningChapters.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg>Chapters</a></li>
                                <li><a id="navLessons" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/Lessons.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg>Lessons</a></li>
                            </ul>
                        </li>

                        <li class="app-nav-group">
                            <span class="app-nav-group__label">Assessment</span>
                            <ul class="app-nav-group__list">
                                <li><a id="navPracticeSets" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/PracticeSets.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 14l2 2 4-4"/></svg>Practice Sets</a></li>
                                <li><a id="navQuestionBank" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/QuestionBank.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/></svg>Question Bank</a></li>
                                <li><a id="navMockExam" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/MockExam.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/></svg>Mock Exam</a></li>
                            </ul>
                        </li>

                        <li class="app-nav-group">
                            <span class="app-nav-group__label">Game</span>
                            <ul class="app-nav-group__list">
                                <li><a id="navHiddenRoadSign" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/HiddenRoadSigns.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 12h4M8 10v4"/><path d="M15 13h.01M18 11h.01"/><path d="M17.3 5H6.7a4 4 0 0 0-3.9 3.2l-1.5 7A3 3 0 0 0 4.2 19a3 3 0 0 0 2.4-1.2l1.4-2h8l1.4 2a3 3 0 0 0 2.4 1.2 3 3 0 0 0 2.9-3.8l-1.5-7A4 4 0 0 0 17.3 5z"/></svg>Road Sign Game</a></li>
                                <li><a id="navRoadSignAssets" runat="server" class="app-nav-link app-nav-link--sub" href="~/Admin/RoadSignAssets.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>Road Sign Assets</a></li>
                            </ul>
                        </li>

                        <li><a id="navProfile" runat="server" class="app-nav-link" href="~/Admin/Profile.aspx"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Profile</a></li>
                    </ul>
                </nav>

                <div class="app-sidebar__footer">
                    <a class="app-nav-link app-nav-link--logout" href="~/Logout.aspx" runat="server"><svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>Logout</a>
                </div>
            </aside>

            <div class="app-main">
                <header class="app-header">
                    <div class="app-header__left">
                        <button type="button" id="drawerToggle" class="drawer-toggle" aria-expanded="false" aria-controls="appSidebar" aria-label="Toggle navigation menu">
                            <span class="drawer-toggle__bar"></span>
                        </button>
                        <h1 class="app-header__title"><asp:Literal ID="litPageTitle" runat="server">Dashboard</asp:Literal></h1>
                    </div>

                    <a class="app-user" href="~/Admin/Profile.aspx" runat="server">
                        <span class="app-user__avatar"><img id="imgAvatar" runat="server" class="app-user__avatar-img" alt="" visible="false" /><asp:Literal ID="litAvatarInitials" runat="server" /></span>
                        <span class="app-user__info">
                            <span class="app-user__name"><asp:Literal ID="litFullName" runat="server" /></span>
                            <span class="app-user__role"><asp:Literal ID="litRole" runat="server" /></span>
                        </span>
                    </a>
                </header>

                <main class="app-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>
    </form>
    <script src="<%= ResolveUrl("~/Scripts/app-shell.js") + "?v=20261011-nav" %>"></script>
    <script src="<%= ResolveUrl("~/Scripts/confirm-modal.js") + "?v=20261019" %>"></script>
    <script src="<%= ResolveUrl("~/Scripts/table-labels.js") + "?v=20261017" %>"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
